# ============================================================================
# RefundRadar - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env or .env.local to version control
# ============================================================================

# ============================================================================
# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Cloudflare Worker & App Settings (Required)
# Deploy worker first, then add its URL here
# ============================================================================
NEXT_PUBLIC_WORKER_URL=https://refundradar-worker.your-subdomain.workers.dev
# 32-byte hex string for AES-GCM encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# Resend Email Configuration (Required for alerts)
# Get API key from: https://resend.com/api-keys
# ============================================================================
RESEND_API_KEY=re_1234567890abcdef

# ============================================================================
# RevenueCat Webhook Secret (Required for webhook verification)
# Generate a secret and add to RevenueCat dashboard → Integrations → Webhooks
# ============================================================================
REVENUECAT_WEBHOOK_SECRET=whsec_abcdef1234567890

# ============================================================================
# Optional: Analytics & Monitoring
# ============================================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================================================
# Development Overrides (Optional)
# ============================================================================
# NODE_ENV=development
# NEXT_TELEMETRY_DISABLED=1